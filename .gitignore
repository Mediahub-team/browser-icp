.DS_Store

# Секреты (токены API) — никогда не коммитим
.env
08-ads/tools/.env

# Python байткод
__pycache__/
*.pyc

# Сгенерированные артефакты тулзов (регенерируются скриптами)
08-ads/tools/*/build/

# HTML-снапшоты референсов — временные, регенерируются через add_references.py
08-ads/references/*.html

# Obsidian — волатильное (конфиг app/core/community коммитим, остальное нет)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/graph.json
.obsidian/hotkeys.json
.obsidian/cache
.obsidian/plugins/
.obsidian/themes/
.obsidian/snippets/
